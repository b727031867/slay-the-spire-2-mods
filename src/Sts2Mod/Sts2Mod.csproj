<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Version>0.3.17</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <GameDir Condition="'$(GameDir)' == ''">$(STS2_GAME_DIR)</GameDir>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <PathMap>$(MSBuildProjectDirectory)=/src/Sts2Mod</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDir)/data_sts2_windows_x86_64/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)/data_sts2_windows_x86_64/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="[3.4.7]" PrivateAssets="all" ExcludeAssets="build;buildTransitive;contentFiles" />
  </ItemGroup>
  <Target Name="CheckGameReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)/data_sts2_windows_x86_64/sts2.dll')" Text="Load scripts/Enter-DevEnvironment.ps1 before building." />
  </Target>
</Project>
